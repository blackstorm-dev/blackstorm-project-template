# Run make init once to configure your SOPS key.
# Run make secrets FILE=secrets/platform/dockerhub.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: dockerhub
  namespace: project-template
spec:
  secretTemplates:
  - name: dockerhub
    labels:
      kargo.akuity.io/cred-type: image
    stringData:
      repoURL: REPLACE_ME
      username: REPLACE_ME
      password: REPLACE_ME
