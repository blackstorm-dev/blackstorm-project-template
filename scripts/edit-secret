#!/usr/bin/env bash
set -euo pipefail

file=${1:?Usage: make secrets FILE=path/to/secret}
case "$file" in
  *.example) echo 'Use FILE without the .example suffix.' >&2; exit 1 ;;
esac
test -f age.key || { echo 'Run make init first.' >&2; exit 1; }
export SOPS_AGE_KEY_FILE="$PWD/age.key"
mkdir -p "$(dirname "$file")"
if [ ! -f "$file" ] && [ -f "$file.example" ]; then
  # Encrypt directly from the example; never copy plaintext credentials to disk.
  case "$file" in
    *.env) format=dotenv ;;
    *.yaml|*.yml) format=yaml ;;
    *.json) format=json ;;
    *) echo 'Supported formats: .env, .yaml, .yml, .json' >&2; exit 1 ;;
  esac
  umask 077
  tmp=$(mktemp "${file}.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  sops encrypt --filename-override "$file" --input-type "$format" --output-type "$format" "$file.example" > "$tmp"
  mv "$tmp" "$file"
fi
exec sops edit "$file"
