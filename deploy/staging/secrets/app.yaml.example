# Run make init once to configure your SOPS key.
# Run make secrets FILE=deploy/staging/secrets/app.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: app
  namespace: project-template-staging
spec:
  secretTemplates:
  - name: app
    type: Opaque
    stringData:
      EXAMPLE_SECRET: REPLACE_ME
