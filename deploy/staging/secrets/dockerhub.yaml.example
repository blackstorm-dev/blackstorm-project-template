# Run make init once to configure your SOPS key.
# Run make secrets FILE=deploy/staging/secrets/dockerhub.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: dockerhub
  namespace: project-template-staging
spec:
  secretTemplates:
  - name: dockerhub
    type: kubernetes.io/dockerconfigjson
    stringData:
      .dockerconfigjson: '{"auths": {"https://index.docker.io/v1/": {"username": "REPLACE_ME", "password": "REPLACE_ME", "auth": "REPLACE_ME"}}}'
